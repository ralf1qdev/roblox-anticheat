    check(V.Number(0, 10, true)(5) and not V.Number(0, 10, true)(5.5), "integer range")
    check(V.String(4)("test") and not V.String(4)("longer"), "string bound")
    check(V.Enum({"a", "b"})("b") and not V.Enum({"a"})("c"), "enum")
