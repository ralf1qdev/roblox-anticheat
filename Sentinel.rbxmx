</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">Evidence</string><ProtectedString name="Source">local Policy = require(script.Parent.Policy)
local Evidence = {}
Evidence.__index = Evidence

function Evidence.new(config, logger, clock)
    return setmetatable({ Config = config, Logger = logger, Clock = clock or os.clock, Records = {} }, Evidence)
end

function Evidence:Add(player, rule, detail)
    local now = self.Clock()
    local record = self.Records[player]
    if not record then
        record = { score = 0, updated = now, rules = {}, keyCount = 0, recent = {}, total = 0 }
        self.Records[player] = record
    end
    record.score = Policy.Decay(record.score, now - record.updated, self.Config.ScoreHalfLife)
    record.updated, record.total = now, record.total + 1
    local bucket = record.rules[rule]
    if not bucket then
        if record.keyCount &gt;= self.Config.MaxRuleKeys then return false end
        bucket = { last = -math.huge, suppressed = 0 }
        record.rules[rule] = bucket
        record.keyCount = record.keyCount + 1
    end
    if now - bucket.last &lt; self.Config.ReportCooldown then
        bucket.suppressed = bucket.suppressed + 1
        return false
    end
    bucket.last = now
    record.score = math.min(self.Config.MaxScore, record.score + (self.Config.Weights[rule] or 3))
    local item = { time = os.time(), rule = rule, detail = tostring(detail):sub(1, 180), score = record.score,
        suppressed = bucket.suppressed }
    bucket.suppressed = 0
    table.insert(record.recent, item)
    if #record.recent &gt; self.Config.MaxEvidence then table.remove(record.recent, 1) end
    self.Logger:Warn("sentinel." .. rule, "Monitor finding; not proof of cheating", {
        userId = player.UserId, score = math.floor(record.score), evidence = item.detail, repeated = item.suppressed,
    })
    return true
end

function Evidence:Get(player)
    local record = self.Records[player]
    if not record then return { score = 0, observations = 0, recent = {} } end
    local recent = {}
    for _, item in ipairs(record.recent) do table.insert(recent, table.clone(item)) end
    return { score = Policy.Decay(record.score, self.Clock() - record.updated, self.Config.ScoreHalfLife),
        observations = record.total, recent = recent }
end

function Evidence:Remove(player) self.Records[player] = nil end
return Evidence
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">Movement</string><ProtectedString name="Source">local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local Policy = require(script.Parent.Policy)
local Movement = {}
Movement.__index = Movement

function Movement.new(config, evidence, logger)
    return setmetatable({ Config = config, Evidence = evidence, Logger = logger, Records = {}, Links = {} }, Movement)
end

function Movement:_reset(player, character)
    local old = self.Records[player]
    self.Records[player] = {
        character = character, state = Policy.NewMovement(), grace = os.clock() + self.Config.SpawnGrace,
        speed = old and old.speed or self.Config.DefaultMaxSpeed, boost = 0, boostUntil = 0,
        exemptUntil = 0, ping = 0, pingUpdated = -math.huge,
    }
end

function Movement:_add(player)
    if self.Links[player] then return end
    self:_reset(player, player.Character)
    self.Links[player] = player.CharacterAdded:Connect(function(character) self:_reset(player, character) end)
end

function Movement:Start()
    self.Added = Players.PlayerAdded:Connect(function(player) self:_add(player) end)
    self.Removing = Players.PlayerRemoving:Connect(function(player) self:Remove(player) end)
    for _, player in ipairs(Players:GetPlayers()) do self:_add(player) end
end

function Movement:Remove(player)
    if self.Links[player] then self.Links[player]:Disconnect() end
    self.Links[player], self.Records[player] = nil, nil
end

function Movement:SetSpeed(player, speed)
    assert(Policy.Finite(speed) and speed &gt;= 0 and speed &lt;= 1000, "Invalid allowed speed")
    if self.Records[player] then
        self.Records[player].speed = speed
        self.Records[player].state = Policy.NewMovement()
    end
end

function Movement:Exempt(player, duration, reason)
    assert(Policy.Finite(duration) and duration &gt; 0 and duration &lt;= 30, "Allowance must be 0–30 seconds")
    assert(type(reason) == "string" and #reason &gt; 0 and #reason &lt;= 80, "Provide a short reason")
    local record = self.Records[player]
    if record then
        record.exemptUntil = math.max(record.exemptUntil, os.clock() + duration)
        record.state = Policy.NewMovement()
        self.Logger:Debug("sentinel.allowance", reason, { userId = player.UserId, seconds = duration })
    end
end

function Movement:Boost(player, speed, duration)
    assert(Policy.Finite(speed) and speed &gt;= 0 and speed &lt;= 1000, "Invalid boost speed")
    assert(Policy.Finite(duration) and duration &gt; 0 and duration &lt;= 120, "Boost must be 0–120 seconds")
    local record = self.Records[player]
    if record then
        record.boost, record.boostUntil = speed, os.clock() + duration
        record.state = Policy.NewMovement()
    end
end

function Movement:Sample(player, record, now)
    local character = record.character
    if not character or character ~= player.Character then record.state = Policy.NewMovement(); return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root or not root:IsA("BasePart") or humanoid.Health &lt;= 0 then
        record.state = Policy.NewMovement(); return
    end
    local position = root.Position
    if not Policy.Finite(position.X) or not Policy.Finite(position.Y) or not Policy.Finite(position.Z) then
        self.Evidence:Add(player, "movement.invalid", "Non-finite root position")
        record.state = Policy.NewMovement(); return
    end
    if now - record.pingUpdated &gt; 2 then
        record.pingUpdated = now
        local ok, ping = pcall(function() return player:GetNetworkPing() end)
        record.ping = ok and Policy.Finite(ping) and math.max(0, ping) or 0
    end
    local exempt = now &lt; record.grace or now &lt; record.exemptUntil or humanoid.SeatPart ~= nil or root.Anchored
    local sample = { x = position.X, y = position.Y, z = position.Z, time = now,
        ping = record.ping, grounded = true, exempt = exempt,
        maxSpeed = now &lt; record.boostUntil and math.max(record.speed, record.boost) or record.speed }
    local params
    if not exempt and (self.Config.HoverEnabled or self.Config.NoclipEnabled) then
        params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { character }
        params.RespectCanCollide = true
        params.CollisionGroup = root.CollisionGroup
        if self.Config.HoverEnabled then
            sample.grounded = Workspace:Raycast(position, Vector3.new(0, -self.Config.GroundProbe, 0), params) ~= nil
        end
    end
    local previous = record.state.previous
    if self.Config.NoclipEnabled and not exempt and previous then
        local old = Vector3.new(previous.x, previous.y, previous.z)
        local delta = position - old
        local dt = now - previous.time
        if dt &gt; 0 and dt &lt;= self.Config.MaxSampleGap and delta.Magnitude &gt; 3 and delta.Magnitude &lt; 40 then
            local hit = Workspace:Raycast(old, delta, params)
            if hit and hit.Distance &gt; 0.5 and hit.Distance &lt; delta.Magnitude - 0.5
                and math.abs(hit.Normal.Y) &lt; 0.3 then
                self.Evidence:Add(player, "movement.noclip", string.format("collidable wall intersected, travel=%.1f", delta.Magnitude))
            end
        end
    end
    for _, report in ipairs(Policy.Movement(record.state, sample, self.Config)) do
        self.Evidence:Add(player, report.rule, report.detail)
    end
end

function Movement:Step(now)
    for player, record in pairs(self.Records) do
        local ok = pcall(function() self:Sample(player, record, now) end)
        if not ok then
            record.state = Policy.NewMovement()
            if not record.errorAt or now - record.errorAt &gt; 30 then
                record.errorAt = now
                self.Logger:Error("sentinel.monitor", "Movement monitor failed for a player", { userId = player.UserId })
            end
        end
    end
end

function Movement:Destroy()
    if self.Added then self.Added:Disconnect() end
    if self.Removing then self.Removing:Disconnect() end
    for _, link in pairs(self.Links) do link:Disconnect() end
    table.clear(self.Links)
    table.clear(self.Records)
end
return Movement
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">Policy</string><ProtectedString name="Source">local Policy = {}

function Policy.Finite(n)
    return type(n) == "number" and n == n and math.abs(n) &lt; math.huge
end

function Policy.Bucket(bucket, now, rate, burst)
    if not bucket then bucket = { tokens = burst, time = now } end
    bucket.tokens = math.min(burst, bucket.tokens + math.max(0, now - bucket.time) * rate)
    bucket.time = now
    if bucket.tokens &lt; 1 then return false, bucket end
    bucket.tokens = bucket.tokens - 1
    return true, bucket
end

function Policy.Decay(score, elapsed, halfLife)
    return score * 2 ^ (-math.max(0, elapsed) / halfLife)
end

function Policy.NewMovement()
    return { previous = nil, path = 0, elapsed = 0, hover = 0 }
end

function Policy.Reset(state, sample)
    state.previous, state.path, state.elapsed, state.hover = sample, 0, 0, 0
end

function Policy.Movement(state, sample, config)
    local reports = {}
    if not Policy.Finite(sample.x) or not Policy.Finite(sample.y) or not Policy.Finite(sample.z) then
        state.previous = nil
        return {{ rule = "movement.invalid", detail = "Non-finite position" }}
    end
    local old = state.previous
    if not old or sample.exempt then Policy.Reset(state, sample); return reports end
    local dt = sample.time - old.time
    if dt &lt;= 0 or dt &gt; config.MaxSampleGap then Policy.Reset(state, sample); return reports end
    local dx, dy, dz = sample.x - old.x, sample.y - old.y, sample.z - old.z
    local horizontal = math.sqrt(dx * dx + dz * dz)
    local distance = math.sqrt(dx * dx + dy * dy + dz * dz)
    local speed = sample.maxSpeed
    local margin = config.SpeedSlack + speed * math.min(config.PingAllowanceCap, math.max(0, sample.ping)) * 2
    if distance &gt; math.max(config.TeleportDistance, speed * dt + margin) then
        table.insert(reports, { rule = "movement.teleport", detail = string.format("distance=%.1f dt=%.2f", distance, dt) })
        Policy.Reset(state, sample)
        return reports
    end
    state.path, state.elapsed = state.path + horizontal, state.elapsed + dt
    if state.elapsed &gt;= config.SpeedWindow then
        if state.path &gt; speed * state.elapsed + margin then
            table.insert(reports, { rule = "movement.speed", detail = string.format("observed=%.1f allowed=%.1f window=%.2f", state.path / state.elapsed, speed, state.elapsed) })
        end
        state.path, state.elapsed = 0, 0
    end
    if config.HoverEnabled and not sample.grounded and math.abs(dy / dt) &lt; config.HoverVerticalSpeed then
        state.hover = state.hover + dt
        if state.hover &gt;= config.HoverSeconds then
            table.insert(reports, { rule = "movement.hover", detail = string.format("airborne=%.1f verticalSpeed=%.1f", state.hover, dy / dt) })
            state.hover = 0
        end
    else state.hover = 0 end
    state.previous = sample
    return reports
end
return Policy
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">RemoteGuard</string><ProtectedString name="Source">local Policy = require(script.Parent.Policy)
local Validate = require(script.Parent.Validate)
local RemoteGuard = {}
RemoteGuard.__index = RemoteGuard

function RemoteGuard.new(config, evidence, logger, clock)
    return setmetatable({ Config = config, Evidence = evidence, Logger = logger, Clock = clock or os.clock,
        Routes = {}, Count = 0, Totals = { accepted = 0, rejected = 0, failures = 0 } }, RemoteGuard)
end

function RemoteGuard:_process(route, player, args)
    if route.closed or route.removed[player] then return false end
    local now = self.Clock()
    local accepted, bucket = Policy.Bucket(route.buckets[player], now, route.rate, route.burst)
    route.buckets[player] = bucket
    local function reject(rule, reason)
        self.Totals.rejected = self.Totals.rejected + 1
        self.Evidence:Add(player, rule, route.name .. ": " .. reason)
        return false
    end
    if not accepted then return reject("remote.rate", "request budget exceeded") end
    if args.n ~= route.argCount then return reject("remote.payload", "argument count") end
    if not Validate.Payload(args, self.Config) then return reject("remote.payload", "payload bounds or type") end
    if route.busy[player] then return reject("remote.rate", "handler already in flight") end
    route.busy[player] = true
    local ok, valid = pcall(route.validate, player, table.unpack(args, 1, args.n))
    if route.closed or route.removed[player] then route.busy[player] = nil; return false end
    if not ok then
        route.busy[player] = nil
        self.Totals.failures = self.Totals.failures + 1
        self.Logger:Error("sentinel.validator", "Validator failed; request rejected", { route = route.name })
        return false
    end
    if valid ~= true then
        route.busy[player] = nil
        return reject("remote.schema", "schema or permission rejected")
    end
    if route.closed or route.removed[player] then route.busy[player] = nil; return false end
    local ran, result = pcall(route.handler, player, table.unpack(args, 1, args.n))
    route.busy[player] = nil
    if not ran then
        self.Totals.failures = self.Totals.failures + 1
        self.Logger:Error("sentinel.handler", "Gameplay handler failed", { route = route.name })
        return false
    end
    self.Totals.accepted = self.Totals.accepted + 1
    return true, result
end

function RemoteGuard:Bind(remote, options, handler)
    assert(remote:IsA("RemoteEvent"), "Bind expects a RemoteEvent")
    assert(not self.Routes[remote], "Remote already bound")
    assert(self.Count &lt; self.Config.MaxRemoteBindings, "Remote binding limit reached")
    assert(type(options.Validate) == "function" and type(handler) == "function", "Validator and handler required")
    local rate, burst, argCount = options.Rate or 5, options.Burst or 8, options.ArgCount or 1
    assert(Policy.Finite(rate) and rate &gt; 0 and rate &lt;= 1000, "Invalid rate")
    assert(Policy.Finite(burst) and burst &gt;= 1 and burst &lt;= 1000, "Invalid burst")
    assert(Policy.Finite(argCount) and argCount &gt;= 0 and argCount &lt;= 16 and argCount % 1 == 0, "Invalid argument count")
    local route = { name = remote.Name:sub(1, 60), rate = rate, burst = burst, argCount = argCount,
        validate = options.Validate, handler = handler, buckets = {}, busy = {},
        removed = setmetatable({}, { __mode = "k" }), closed = false }
    self.Routes[remote] = route
    self.Count = self.Count + 1
    route.connection = remote.OnServerEvent:Connect(function(player, ...)
        self:_process(route, player, table.pack(...))
    end)
    return function()
        if route.closed then return end
        route.closed = true
        route.connection:Disconnect()
        self.Routes[remote] = nil
        self.Count = self.Count - 1
        table.clear(route.buckets)
    end
end

function RemoteGuard:Remove(player)
    for _, route in pairs(self.Routes) do
        route.removed[player] = true
        route.buckets[player] = nil
        route.busy[player] = nil
    end
end

function RemoteGuard:Destroy()
    for _, route in pairs(self.Routes) do
        route.closed = true
        route.connection:Disconnect()
    end
    table.clear(self.Routes)
    self.Count = 0
end
return RemoteGuard
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX7"><Properties><string name="Name">Service</string><ProtectedString name="Source">local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local Config = require(script.Parent.Config)
local Policy = require(script.Parent.Policy)
local Validate = require(script.Parent.Validate)
local Evidence = require(script.Parent.Evidence)
local RemoteGuard = require(script.Parent.RemoteGuard)
local Movement = require(script.Parent.Movement)
local Service = {}
Service.__index = Service
local singleton

function Service.Get()
    assert(RunService:IsServer(), "Sentinel is server-only")
    if singleton then return singleton end
    assert(Config.Mode == "Monitor", "This version supports Monitor mode only")
    assert(Config.SampleInterval &gt;= 0.1 and Config.SampleInterval &lt;= 2, "Invalid sample interval")
    assert(Config.ScoreHalfLife &gt; 0 and Config.ReportCooldown &gt;= 1 and Config.MaxEvidence &gt;= 1, "Invalid evidence settings")
    local logger = require(script.Parent.Signal.Logger).Get()
    local evidence = Evidence.new(Config, logger)
    local self = setmetatable({ Logger = logger, Evidence = evidence, Validate = Validate, Config = Config,
        Remotes = RemoteGuard.new(Config, evidence, logger), Movement = Movement.new(Config, evidence, logger),
        Active = Config.Enabled, LastSample = os.clock() }, Service)
    singleton = self
    if Config.Enabled then
        self.Movement:Start()
        self.Removing = Players.PlayerRemoving:Connect(function(player)
            self.Evidence:Remove(player); self.Remotes:Remove(player)
        end)
        self.Heartbeat = RunService.Heartbeat:Connect(function()
            local now = os.clock()
            if now - self.LastSample &gt;= Config.SampleInterval then
                self.LastSample = now
                self.Movement:Step(now)
            end
        end)
        logger:Info("sentinel.start", "Monitoring only; no automatic kicks or bans")
    end
    return self
end

function Service:BindRemote(remote, options, handler)
    assert(self.Active, "Sentinel is disabled; guarded remotes were not installed")
    return self.Remotes:Bind(remote, options, handler)
end
function Service:SetAllowedSpeed(player, speed) self.Movement:SetSpeed(player, speed) end
function Service:AllowMovement(player, seconds, reason) self.Movement:Exempt(player, seconds, reason) end
function Service:AllowSpeedBoost(player, speed, seconds) self.Movement:Boost(player, speed, seconds) end
function Service:GetEvidence(player) return self.Evidence:Get(player) end
function Service:GetStats() return { logs = self.Logger:GetStats(), remotes = table.clone(self.Remotes.Totals) } end

function Service:Teleport(player, target)
    assert(typeof(target) == "CFrame", "Teleport expects a server-chosen CFrame")
    local character = player.Character
    if not character then return false end
    self:AllowMovement(player, 2, "server teleport")
    character:PivotTo(target)
    return true
end

function Service:IsNear(player, target, maxDistance)
    if not Policy.Finite(maxDistance) or maxDistance &lt;= 0 then return false end
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health &lt;= 0
        or typeof(target) ~= "Instance" or not target:IsA("BasePart") or not target:IsDescendantOf(Workspace) then return false end
    local distance = (root.Position - target.Position).Magnitude
    return Policy.Finite(distance) and distance &lt;= maxDistance
end

function Service:HasLineOfSight(player, target, maxDistance)
    if not self:IsNear(player, target, maxDistance) then return false end
    local character = player.Character
    local head = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
    if not head or not head:IsA("BasePart") then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { character }
    params.RespectCanCollide = true
    local hit = Workspace:Raycast(head.Position, target.Position - head.Position, params)
    return hit == nil or hit.Instance == target
end
return Service
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">Validate</string><ProtectedString name="Source">local Policy = require(script.Parent.Policy)
local Validate = {}

function Validate.Number(minimum, maximum, integer)
    return function(value)
        return Policy.Finite(value) and value &gt;= minimum and value &lt;= maximum and (not integer or value % 1 == 0)
    end
end

function Validate.String(maxBytes, pattern)
    return function(value)
        return type(value) == "string" and #value &lt;= maxBytes and utf8.len(value) ~= nil
            and (not pattern or value:match(pattern) ~= nil)
    end
end

function Validate.Enum(values)
    local allowed = {}
    for _, value in ipairs(values) do allowed[value] = true end
    return function(value) return type(value) == "string" and allowed[value] == true end
end

function Validate.Boolean(value) return type(value) == "boolean" end

function Validate.Vector3(maxMagnitude)
    return function(value)
        return typeof(value) == "Vector3" and Policy.Finite(value.X) and Policy.Finite(value.Y)
            and Policy.Finite(value.Z) and value.Magnitude &lt;= maxMagnitude
    end
end

function Validate.Optional(check)
    return function(value) return value == nil or check(value) end
end

function Validate.Object(schema)
    return function(value)
        if type(value) ~= "table" then return false end
        for key in pairs(value) do if not schema[key] then return false end end
        for key, check in pairs(schema) do if not check(value[key]) then return false end end
        return true
    end
end

function Validate.Instance(className, ancestor)
    return function(value)
        return typeof(value) == "Instance" and value:IsA(className) and value:IsDescendantOf(ancestor)
    end
end

function Validate.Payload(value, config)
    local visited, nodes = {}, 0
    local function scan(item, depth)
        nodes = nodes + 1
        if nodes &gt; config.MaxPayloadNodes or depth &gt; config.MaxPayloadDepth then return false end
        local kind = typeof(item)
        if kind == "nil" or kind == "boolean" then return true end
        if kind == "number" then return Policy.Finite(item) end
        if kind == "string" then return #item &lt;= config.MaxStringBytes and utf8.len(item) ~= nil end
        if kind == "Vector3" then return Policy.Finite(item.X) and Policy.Finite(item.Y) and Policy.Finite(item.Z) end
        if kind == "Instance" then return true end
        if kind ~= "table" or visited[item] then return false end
        visited[item] = true
        for key, child in pairs(item) do
            if (type(key) ~= "string" and type(key) ~= "number") or not scan(key, depth + 1)
                or not scan(child, depth + 1) then return false end
        end
        visited[item] = nil
        return true
    end
    return scan(value, 0)
end
return Validate
</ProtectedString></Properties></Item><Item class="Folder" referent="RBX11"><Properties><string name="Name">Signal</string></Properties><Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">Config</string><ProtectedString name="Source">local config = require(script.Parent.Parent.Config)
return {
    Enabled = config.Enabled,
    StudioDelivery = config.StudioDelivery,
    MinLevel = "INFO",
    Console = config.Console,
    Transport = config.Transport,
    RelayUrl = config.RelayUrl,
    RelaySecretName = config.RelaySecretName,
    WebhookUrl = config.WebhookUrl,
    WebhookId = "",
    SecretName = "SENTINEL_DISCORD_TOKEN",
    FlushInterval = 5,
    MaxQueue = 200,
    BatchSize = 6,
    MaxAttempts = 5,
    CaptureServerErrors = false,
    CaptureWarnings = false,
    TrackPlayers = false,
    TrackCharacters = false,
    IncludePlayerNames = false,
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">Logger</string><ProtectedString name="Source">local Http = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local ScriptContext = game:GetService("ScriptContext")
local LogService = game:GetService("LogService")
local Logger = {}
Logger.__index = Logger
local LEVEL = { DEBUG = 10, INFO = 20, WARN = 30, ERROR = 40 }
local COLORS = { DEBUG = 9807270, INFO = 6730495, WARN = 16763979, ERROR = 16745861 }
local singleton

local function clean(value, limit)
    local text = tostring(value)
    if not utf8.len(text) then return "[invalid UTF-8]" end
    text = text:gsub("https://[^%s]+/api/webhooks/[^%s]+", "[redacted webhook]")
    text = text:gsub("https://[^%s]+/api/v%d+/webhooks/[^%s]+", "[redacted webhook]")
    text = text:gsub("[%z\1-\8\11\12\14-\31]", " ")
    text = text:gsub("`", "'"):gsub("@", "＠")
    if #text &gt; limit then
        text = text:sub(1, limit - 3)
        while not utf8.len(text) do text = text:sub(1, -2) end
        text = text .. "..."
    end
    return text
end

local function detailsText(details)
    if type(details) ~= "table" then return details and clean(details, 240) or "" end
    local keys, lines = {}, {}
    for key in pairs(details) do
        if type(key) == "string" then table.insert(keys, key) end
    end
    table.sort(keys)
    for _, key in ipairs(keys) do
        if #lines &gt;= 6 then break end
        local lower = key:lower()
        local sensitive = lower:find("token", 1, true) or lower:find("secret", 1, true)
            or lower:find("password", 1, true) or lower:find("authorization", 1, true)
            or lower:find("webhook", 1, true) or lower:find("cookie", 1, true)
        local value = details[key]
        local rendered
        if sensitive then rendered = "[redacted]"
        elseif type(value) == "table" then rendered = "[table omitted]"
        elseif typeof(value) == "Instance" then rendered = value.ClassName
        else rendered = clean(value, 90) end
        table.insert(lines, clean(key, 30) .. "=" .. rendered)
    end
    return clean(table.concat(lines, " | "), 240)
end

local function header(response, name)
    for key, value in pairs(response.Headers or {}) do
        if key:lower() == name:lower() then return tonumber(value) end
    end
    return nil
end

function Logger.new(config, requestOverride)
    assert(RunService:IsServer(), "Signal belongs in ServerScriptService, never on a client")
    assert(LEVEL[config.MinLevel or "INFO"], "Invalid MinLevel")
    local self = setmetatable({}, Logger)
    self.Config = table.clone(config)
    self.Config.BatchSize = math.clamp(math.floor(config.BatchSize or 6), 1, 6)
    self.Config.MaxQueue = math.clamp(math.floor(config.MaxQueue or 200), 6, 2000)
    self.Config.FlushInterval = math.max(1, config.FlushInterval or 5)
    self.Config.MaxAttempts = math.clamp(math.floor(config.MaxAttempts or 5), 1, 10)
    self.Queue, self.Connections, self.PlayerConnections = {}, {}, {}
    self.Sent, self.Dropped, self.Failed, self.Suppressed = 0, 0, 0, 0
    self.Accepting, self.Running, self.InFlight = true, false, false
    self.NextAttempt, self.Attempts, self.RecentErrors = 0, 0, {}
    self.Request = requestOverride
    self.Deliver = config.Enabled ~= false and (not RunService:IsStudio() or config.StudioDelivery == true)
    if requestOverride then self.Deliver = true end
    return self
end

function Logger:_notice(message)
    warn("[Sentinel/internal] " .. message)
end

function Logger:Log(level, event, message, details)
    level = string.upper(level)
    assert(LEVEL[level], "Unknown log level")
    if not self.Accepting or self.Config.Enabled == false then return false end
    if LEVEL[level] &lt; LEVEL[self.Config.MinLevel or "INFO"] then return false end
    local entry = {
        Level = level, Event = clean(event, 50), Message = clean(message or "", 150),
        Details = detailsText(details), Time = os.date("!%H:%M:%S"),
    }
    if self.Config.Console then
        local line = "[Sentinel] [" .. level .. "] " .. entry.Event .. " | " .. entry.Message
        if level == "WARN" or level == "ERROR" then warn(line) else print(line) end
    end
    if not self.Deliver then return true end
    if #self.Queue &gt;= self.Config.MaxQueue then
        self.Dropped = self.Dropped + 1
        return false
    end
    table.insert(self.Queue, entry)
    return true
end

function Logger:Debug(event, message, details) return self:Log("DEBUG", event, message, details) end
function Logger:Info(event, message, details) return self:Log("INFO", event, message, details) end
function Logger:Warn(event, message, details) return self:Log("WARN", event, message, details) end
function Logger:Error(event, message, details) return self:Log("ERROR", event, message, details) end

function Logger:Timed(event, callback, ...)
    local start = os.clock()
    local results = table.pack(pcall(callback, ...))
    if results[1] then
        self:Debug(event, "Completed", { elapsedMs = math.floor((os.clock() - start) * 1000) })
        return true, table.unpack(results, 2, results.n)
    end
    self:Error(event, clean(results[2], 150), { elapsedMs = math.floor((os.clock() - start) * 1000) })
    return false, results[2]
end

function Logger:_payload(count)
    local lines, highest = {}, "INFO"
    for i = 1, count do
        local item = self.Queue[i]
        if LEVEL[item.Level] &gt; LEVEL[highest] then highest = item.Level end
        local line = "`" .. item.Time .. " UTC` **" .. item.Level .. " · " .. item.Event .. "**\n" .. item.Message
        if item.Details ~= "" then line = line .. "\n`" .. item.Details .. "`" end
        table.insert(lines, line)
    end
    return {
        username = "Sentinel",
        allowed_mentions = { parse = {} },
        embeds = {{
            title = "Sentinel · Security monitoring", color = COLORS[highest],
            description = table.concat(lines, "\n\n"),
            fields = {
                { name = "Place", value = tostring(game.PlaceId), inline = true },
                { name = "Server", value = clean(game.JobId ~= "" and game.JobId or "Studio", 80), inline = true },
            },
            footer = { text = "Queued: " .. #self.Queue .. " · Dropped: " .. self.Dropped .. " · Failed: " .. self.Failed },
            timestamp = DateTime.now():ToIsoDate(),
        }},
    }
end

function Logger:_configureTransport()
    if self.Request then return true end
    if Http.HttpEnabled == false then
        self.Deliver = false
        self:_notice("Delivery disabled: enable Allow HTTP Requests in Experience Settings &gt; Security, then restart the test.")
        return false
    end
    local setupHint = "check webhook configuration"
    local ok = pcall(function()
        if self.Config.Transport == "Relay" then
            setupHint = "check RelayUrl and your relay Secret/Local Secret"
            assert(type(self.Config.RelayUrl) == "string" and self.Config.RelayUrl:match("^https://"), "HTTPS required")
            self.Url = self.Config.RelayUrl
            self.Headers = {
                ["Content-Type"] = "application/json",
                ["Authorization"] = Http:GetSecret(self.Config.RelaySecretName):AddPrefix("Bearer "),
            }
        elseif type(self.Config.WebhookUrl) == "string" and self.Config.WebhookUrl:match("%S") then
            setupHint = "paste a valid FULL Discord webhook URL into Config.WebhookUrl"
            local url = self.Config.WebhookUrl:match("^%s*(.-)%s*$")
            url = url:match("^[^?#]+") or ""
            url = url:gsub("^https://discordapp%.com/", "https://discord.com/")
            local base = url:match("^https://discord%.com/api/webhooks/%d+/[%w_%-]+$")
                or url:match("^https://discord%.com/api/v%d+/webhooks/%d+/[%w_%-]+$")
            assert(base, "Invalid webhook URL")
            self.Url = base .. "?wait=true"
            self.Headers = { ["Content-Type"] = "application/json" }
        else
            setupHint = "paste your full URL into Config.WebhookUrl, or configure WebhookId and Secret/Local Secret"
            assert(type(self.Config.WebhookId) == "string" and self.Config.WebhookId:match("^%d+$"), "Webhook ID required")
            self.Url = Http:GetSecret(self.Config.SecretName)
                :AddPrefix("https://discord.com/api/webhooks/" .. self.Config.WebhookId .. "/")
                :AddSuffix("?wait=true")
            self.Headers = { ["Content-Type"] = "application/json" }
        end
    end)
    if not ok then
        self.Deliver = false
        self:_notice("Delivery disabled: " .. setupHint .. ". Output still works.")
    end
    return ok
end

function Logger:Step()
    if not self.Deliver or self.InFlight or #self.Queue == 0 or os.clock() &lt; self.NextAttempt then return false end
    local count = math.min(self.Config.BatchSize, #self.Queue)
    self.InFlight = true
    local ok, response = pcall(function()
        local payload = self:_payload(count)
        if self.Request then return self.Request(payload) end
        return Http:RequestAsync({ Url = self.Url, Method = "POST", Headers = self.Headers, Body = Http:JSONEncode(payload) })
    end)
    self.InFlight = false
    local code = ok and type(response) == "table" and tonumber(response.StatusCode) or 0
    self.NextAttempt = os.clock() + self.Config.FlushInterval
    if code &gt;= 200 and code &lt; 300 then
        for _ = 1, count do table.remove(self.Queue, 1) end
        self.Sent = self.Sent + count
        self.Attempts = 0
        if header(response, "x-ratelimit-remaining") == 0 then
            self.NextAttempt = os.clock() + math.max(self.Config.FlushInterval, header(response, "x-ratelimit-reset-after") or 1)
        end
        return true
    end
    self.Attempts = self.Attempts + 1
    if code == 401 or code == 403 or code == 404 then
        self.Failed = self.Failed + #self.Queue
        table.clear(self.Queue)
        self.Deliver = false
        self:_notice("Delivery stopped after HTTP " .. code .. ". Check webhook access; use your own relay if direct delivery is denied.")
        return false
    end
    local retryable = code == 0 or code == 429 or code &gt;= 500
    local delay = math.min(60, 2 ^ self.Attempts)
    if code == 429 then
        local decodedOk, decoded = pcall(function() return Http:JSONDecode(response.Body or "") end)
        local retryAfter = decodedOk and type(decoded) == "table" and tonumber(decoded.retry_after) or nil
        delay = math.max(delay, retryAfter or 0, header(response, "retry-after") or 0)
    end
    self.NextAttempt = os.clock() + math.max(self.Config.FlushInterval, delay) + math.random()
    if not retryable or self.Attempts &gt;= self.Config.MaxAttempts then
        for _ = 1, count do table.remove(self.Queue, 1) end
        self.Failed = self.Failed + count
        self.Attempts = 0
        self:_notice("Dropped a failed batch (HTTP " .. code .. "). See GetStats(); payloads are not printed.")
    end
    return false
end

function Logger:GetStats()
    return { queued = #self.Queue, sent = self.Sent, dropped = self.Dropped,
        failed = self.Failed, suppressed = self.Suppressed, deliveryEnabled = self.Deliver }
end

function Logger:_capture(level, event, message, details)
    local now = os.clock()
    if not self.ErrorWindow or now - self.ErrorWindow &gt;= 10 then
        self.ErrorWindow, self.RecentErrors = now, {}
        self.ErrorCount = 0
    end
    local key = level .. clean(message, 150)
    if self.RecentErrors[key] or self.ErrorCount &gt;= 20 then
        self.Suppressed = self.Suppressed + 1
        return
    end
    self.RecentErrors[key] = true
    self.ErrorCount = self.ErrorCount + 1
    self:Log(level, event, message, details)
end

function Logger:_playerDetails(player)
    local result = { userId = player.UserId }
    if self.Config.IncludePlayerNames then result.username = player.Name end
    return result
end

function Logger:_trackPlayer(player, existing)
    if self.PlayerConnections[player] then return end
    local record = { Links = {}, CharacterLinks = {}, Joined = os.clock() }
    self.PlayerConnections[player] = record
    self:Info(existing and "player.present" or "player.join", "Player connected", self:_playerDetails(player))
    local function characterAdded(character)
        if record.Character == character then return end
        record.Character = character
        for _, link in ipairs(record.CharacterLinks) do link:Disconnect() end
        table.clear(record.CharacterLinks)
        self:Info("character.spawn", "Character spawned", self:_playerDetails(player))
        task.spawn(function()
            local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 10)
            if not humanoid or not humanoid:IsA("Humanoid") or self.PlayerConnections[player] ~= record
                or record.Character ~= character then return end
            table.insert(record.CharacterLinks, humanoid.Died:Connect(function()
                self:Info("character.death", "Character died", self:_playerDetails(player))
            end))
        end)
    end
    if self.Config.TrackCharacters then
        table.insert(record.Links, player.CharacterAdded:Connect(characterAdded))
        if player.Character then characterAdded(player.Character) end
    end
end

function Logger:Start()
    if self.Running then return self end
    if not self.Accepting then error("Cannot restart a stopped logger") end
    self.Running = true
    if self.Deliver then self:_configureTransport() end
    local function connect(signal, callback) table.insert(self.Connections, signal:Connect(callback)) end
    if self.Config.TrackPlayers then
        connect(Players.PlayerAdded, function(player) self:_trackPlayer(player, false) end)
        connect(Players.PlayerRemoving, function(player)
            local record = self.PlayerConnections[player]
            local data = self:_playerDetails(player)
            if record then
                data.sessionSeconds = math.floor(os.clock() - record.Joined)
                for _, link in ipairs(record.Links) do link:Disconnect() end
                for _, link in ipairs(record.CharacterLinks) do link:Disconnect() end
            end
            self.PlayerConnections[player] = nil
            self:Info("player.leave", "Player disconnected", data)
        end)
        for _, player in ipairs(Players:GetPlayers()) do self:_trackPlayer(player, true) end
    end
    if self.Config.CaptureServerErrors then
        connect(ScriptContext.Error, function(message, stack, source)
            if source and source:IsDescendantOf(script.Parent) then return end
            if tostring(message):find("[Sentinel", 1, true) then return end
            self:_capture("ERROR", "script.error", message, { source = source and source:GetFullName() or "unknown", stack = stack })
        end)
    end
    if self.Config.CaptureWarnings then
        connect(LogService.MessageOut, function(message, messageType)
            if messageType == Enum.MessageType.MessageWarning and not message:find("[Sentinel", 1, true) then
                self:_capture("WARN", "script.warning", message)
            end
        end)
    end
    self:Info("server.start", "Logger started", { placeVersion = game.PlaceVersion })
    task.spawn(function()
        while self.Running do
            task.wait(0.5)
            if self.Running then self:Step() end
        end
    end)
    return self
end

function Logger:Stop(timeout)
    if not self.Accepting then return end
    self:Info("server.stop", "Server shutting down")
    self.Accepting, self.Running = false, false
    for _, link in ipairs(self.Connections) do link:Disconnect() end
    for _, record in pairs(self.PlayerConnections) do
        for _, link in ipairs(record.Links) do link:Disconnect() end
        for _, link in ipairs(record.CharacterLinks) do link:Disconnect() end
    end
    table.clear(self.PlayerConnections)
    local deadline = os.clock() + math.clamp(timeout or 8, 0, 20)
    while self.Deliver and #self.Queue &gt; 0 and os.clock() &lt; deadline do
        self:Step()
        task.wait(0.1)
    end
end

function Logger.Get()
    if not singleton then
        singleton = Logger.new(require(script.Parent.Config)):Start()
        game:BindToClose(function() singleton:Stop(8) end)
    end
    return singleton
end
return Logger
